<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- "Reinstall from my Mac" talks plain http to the Mac's Tailscale address (the link is encrypted by Tailscale).
         Allow exactly that host instead of disabling App Transport Security.
         Tools/install.sh renders this template to Info.plist (gitignored) using the address stored in
         ~/Library/Application Support/DevRobotics/mac-host; with no such file the exception is omitted. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>__MAC_HOST__</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <false/>
            </dict>
        </dict>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>DevRobotics talks to your Mac and Raspberry Pi over your private Tailscale network.</string>
</dict>
</plist>
