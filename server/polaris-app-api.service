# Replace USER with the service account's home directory name before installing.
[Unit]
Description=Polaris app API (DevRobotics iPhone app backend)
After=network.target

[Service]
Type=simple
User=polaris
WorkingDirectory=/home/USER/polaris-app
ExecStart=/home/USER/polaris/.venv/bin/python /home/USER/polaris-app/polaris_app_api.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
