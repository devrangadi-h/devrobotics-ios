# Replace USER with the service account's home directory name before installing.
[Unit]
Description=Polaris app cache purge (drafts, blobs, thumbnails)

[Service]
Type=oneshot
User=polaris
WorkingDirectory=/home/USER/polaris-app
ExecStart=/home/USER/polaris/.venv/bin/python /home/USER/polaris-app/polaris_app_api.py purge
Nice=10
